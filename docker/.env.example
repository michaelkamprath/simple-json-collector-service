# Collector's internal non-TLS port and proxy's published TLS port.
JSON_COLLECTOR_PORT=8000
TLS_PORT=8443

# Public DNS name and Let's Encrypt account email.
DOMAIN=collector.example.com
ACME_EMAIL=admin@example.com

# The Caddy module is selected at build time; the provider name is used at runtime.
CADDY_DNS_MODULE=github.com/caddy-dns/cloudflare
DNS_PROVIDER=cloudflare
# Keep the real API token only in docker/.env.
DNS_API_TOKEN=replace-with-dns-api-token

# Collector authentication is enabled by the mounted manifest.
JSON_COLLECTOR_TOKEN_HEADER=X-JSON-Collector-Token
MAX_JSONL_FILE_SIZE=52428800
